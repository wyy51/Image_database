<script type="text/javascript">
var slider_imgs = [
  "https://raw.githubusercontent.com/wyy51/Image_database/main/005.png",
  "https://raw.githubusercontent.com/wyy51/Image_database/main/006.png",
  "https://raw.githubusercontent.com/wyy51/Image_database/main/002.png",
  "https://raw.githubusercontent.com/wyy51/Image_database/main/003.png",
  "https://raw.githubusercontent.com/wyy51/Image_database/main/004.png"
];
var slider_curr = 0, main_img = null, thumbs = null;
function sliderShow(idx){
  slider_curr = ((idx % slider_imgs.length) + slider_imgs.length) % slider_imgs.length;
  if(main_img) main_img.src = slider_imgs[slider_curr];
  if(thumbs){
    for(var i = 0; i < thumbs.children.length; i++){
      thumbs.children[i].className = "slider-thumb" + (i === slider_curr ? " active" : "");
    }
  }
}
function sliderPrev(){ sliderShow(slider_curr - 1); }
function sliderNext(){ sliderShow(slider_curr + 1); }
function sliderGoto(idx){ sliderShow(idx); }
window.addEventListener("DOMContentLoaded", function(){
  main_img = document.getElementById("main-slider-img");
  thumbs = document.getElementById("slider-thumbs");
  for(var i = 0; i < thumbs.children.length; i++){
    thumbs.children[i].onclick = (function(ii){ return function(){ sliderGoto(ii); }; })(i);
  }
  sliderShow(0);
});
</script>
