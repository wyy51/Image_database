  <!-- Image slider JS -->
  <script>
    (function () {
      var images = [
        'https://raw.githubusercontent.com/wyy51/Image_database/main/002.png',
        'https://raw.githubusercontent.com/wyy51/Image_database/main/003.png',
        'https://raw.githubusercontent.com/wyy51/Image_database/main/004.png',
        'https://raw.githubusercontent.com/wyy51/Image_database/main/005.png'
      ];
      var current = 0;
      var mainImg = document.getElementById('main-slider-image');
      var prevBtn = document.getElementById('slider-prev');
      var nextBtn = document.getElementById('slider-next');
      var thumbs = document.querySelectorAll('.slider-thumb');

      function render(index) {
        current = (index + images.length) % images.length;
        mainImg.src = images[current];
        thumbs.forEach(function (thumb, i) {
          if (i === current) {
            thumb.classList.add('active');
          } else {
            thumb.classList.remove('active');
          }
        });
      }

      prevBtn.addEventListener('click', function () {
        render(current - 1);
      });

      nextBtn.addEventListener('click', function () {
        render(current + 1);
      });

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          render(parseInt(thumb.getAttribute('data-index'), 10));
        });
      });
    })();
  </script>
