    }
    .ab-slider-track {
      width: 100%;
      position: relative;
      font-size: 0;
      white-space: nowrap;
      transition: transform 0.35s ease;
      touch-action: pan-y;
    }
    .ab-slide {
      width: 100%;
      display: inline-block;
      vertical-align: top;
    }
    .ab-slide img {
      width: 100%;
      height: auto;
      display: block;
      border-bottom: 3px solid #000000;
    }
    .ab-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      line-height: 44px;
      border: 2px solid #ffffff;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.75);
      color: #ff751f;
      font-size: 28px;
      font-weight: 700;
      text-align: center;
      cursor: pointer;
      z-index: 5;
      -webkit-user-select: none;
