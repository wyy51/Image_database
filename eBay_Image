  <script>
    /* 中文维护注释：轮播脚本 - 支持左右按钮、圆点点击、移动端滑动切换 */
    (function () {
      var track = document.getElementById('ab-track');
      var prev = document.getElementById('ab-prev');
      var next = document.getElementById('ab-next');
      var dotsWrap = document.getElementById('ab-dots');
      var dots = dotsWrap ? dotsWrap.getElementsByClassName('ab-dot') : [];
      var total = 5;
      var index = 0;
      var startX = 0;
      var moveX = 0;

      function render() {
        track.style.transform = 'translateX(' + (-index * 100) + '%)';
        for (var i = 0; i < dots.length; i++) {
          dots[i].className = 'ab-dot' + (i === index ? ' active' : '');
        }
      }

      function go(step) {
        index += step;
        if (index < 0) { index = total - 1; }
        if (index >= total) { index = 0; }
        render();
      }

      prev.onclick = function () { go(-1); };
      next.onclick = function () { go(1); };

      for (var d = 0; d < dots.length; d++) {
        dots[d].onclick = function () {
          index = parseInt(this.getAttribute('data-index'), 10) || 0;
          render();
        };
      }

      track.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        moveX = startX;
      }, false);

      track.addEventListener('touchmove', function (e) {
        moveX = e.touches[0].clientX;
      }, false);

      track.addEventListener('touchend', function () {
        var distance = moveX - startX;
        if (distance > 40) {
          go(-1);
        } else if (distance < -40) {
          go(1);
        }
      }, false);

      render();
    })();
  </script>
