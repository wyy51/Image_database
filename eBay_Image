      font-size: 14px;
      font-weight: 700;
      color: #ffffff;
      background: #1e5d8f;
    }
    .triangle-badge {
      position: absolute;
      top: 6px;
      left: 6px;
      width: 110px;
      height: 110px;
      clip-path: polygon(0 0, 100% 0, 0 100%);
      background: #d91f31;
      filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35));
    }
    .triangle-badge-text {
      position: absolute;
      top: 17px;
      left: 8px;
      font-size: 20px;
      line-height: 1;
      font-weight: 700;
      color: #ffffff;
      transform: rotate(-45deg);
      transform-origin: left top;
      letter-spacing: 0.5px;
