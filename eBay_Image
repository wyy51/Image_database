      opacity: 0;
      pointer-events: none;
    }
    .gallery-main-stage {
      width: calc(100% - 116px);
      min-width: 0;
      position: relative;
      border: 1px solid #d7e0ea;
      background: #fbfdff;
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .gallery-main-item {
      display: none;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
    }
    .gallery-main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      aspect-ratio: 1 / 1;
    }
